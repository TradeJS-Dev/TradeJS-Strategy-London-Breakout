{
  "name": "@tradejs/strategy-london-breakout",
  "version": "0.0.0",
  "description": "UTC session range breakout strategy for TradeJS.",
  "keywords": [
    "ai",
    "claude",
    "codex"
  ],
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": "24.x"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@tradejs/core": "3.1.29-beta.292",
    "@tradejs/strategy-kit": "3.0.6",
    "@tradejs/types": "3.1.29-beta.292",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "tsup",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "checks": "yarn format:check && yarn typecheck && yarn build && yarn test",
    "prettify": "prettier --write ."
  },
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@tradejs/core": "3.1.29-beta.292",
    "@tradejs/strategy-kit": "3.0.6",
    "@tradejs/types": "3.1.29-beta.292"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TradeJS-Dev/TradeJS-Strategy-London-Breakout.git"
  },
  "homepage": "https://tradejs.dev",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
